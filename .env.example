# Public release settings. Keep private keys in the encrypted Foundry keystore.
BLOCKCHAIN_CHAIN_ID=10200
BLOCKCHAIN_RPC_URL=
EURO_TOKEN_ADDRESS=
# Read from the selected token on chain; there is no default decimal value.
EURO_TOKEN_DECIMALS=

# Expected deployment signer and initial owner; must match the selected keystore account.
DEPLOYER_ADDRESS=
DEPLOYER_ACCOUNT=juvantia_admin

# Both settings are the same public address derived from the single server-only Core key.
PAYMENT_INVOICE_ISSUER_ADDRESS=
COMMUNITY_AUTHORIZER_ADDRESS=
# Explicit zero defers Tribunal. A future authority must differ from owner and Core.
TRIBUNAL_ADDRESS=0x0000000000000000000000000000000000000000

# Required only for the standalone community deployment into an already verified stack.
REVENUE_DISTRIBUTOR_ADDRESS=
AERARIUM_ADDRESS=
ASSET_IMPLEMENTATION_ADDRESS=
